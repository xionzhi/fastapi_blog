# Copy to .env at the repository root. Never commit .env.
BLOG_ENVIRONMENT=development
BLOG_URL=http://127.0.0.1:8000
BLOG_DATA_DIR=./data/dev
# Set true behind HTTPS in production.
BLOG_SECURE_COOKIES=false
# Exact frontend origins accepted for local development.
BLOG_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
BLOG_SESSION_HOURS=24
BLOG_TRUSTED_PROXY_NETWORKS=
BLOG_ANALYTICS_ENABLED=true
# Allow Cloudflare Web Analytics on public pages; does not install the beacon.
BLOG_CLOUDFLARE_ANALYTICS_ENABLED=false
BLOG_ANALYTICS_RETENTION_DAYS=90
BLOG_ANALYTICS_MAX_DAILY_VIEWS=50000

# Optional administrator mail. Leave host/from empty until a provider is chosen.
# Only encrypted SMTP is supported: starttls (usually 587) or ssl (usually 465).
BLOG_SMTP_HOST=
BLOG_SMTP_PORT=587
BLOG_SMTP_SECURITY=starttls
BLOG_SMTP_USERNAME=
BLOG_SMTP_PASSWORD=
BLOG_MAIL_FROM=
