# Production template. Copy to .env only on the Linux deployment host.
# Optional package index used only during the Docker build.
# TUNA mirror: https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple

BLOG_ENVIRONMENT=production
BLOG_URL=
BLOG_SECURE_COOKIES=true
BLOG_ALLOWED_ORIGINS=
BLOG_SESSION_HOURS=12
# Exact source addresses seen by the app. For host Nginx -> Docker, use its bridge gateway /32.
# Leave blank until verified; forwarded headers are ignored by default.
BLOG_TRUSTED_PROXY_NETWORKS=
BLOG_ANALYTICS_ENABLED=true
# Allow Cloudflare Web Analytics on public pages; does not install the beacon.
BLOG_CLOUDFLARE_ANALYTICS_ENABLED=false
BLOG_ANALYTICS_RETENTION_DAYS=90
BLOG_ANALYTICS_MAX_DAILY_VIEWS=50000
BLOG_MEMORY_LIMIT=1g
BLOG_CPU_LIMIT=1.0

BLOG_SMTP_HOST=
BLOG_SMTP_PORT=587
BLOG_SMTP_SECURITY=starttls
BLOG_SMTP_USERNAME=
BLOG_SMTP_PASSWORD=
BLOG_MAIL_FROM=
