.coverage.*
htmlcov/

# Frontend dependencies and build output; commit dependency lockfiles.
node_modules/
/frontend/dist/
/frontend/dist.*
*.tsbuildinfo
coverage/

# Logs and temporary inspection artifacts.
logs/
*.log
*.log.*
*.tmp
*.temp
.source-*
.qa-*

