# Include inside the nginx http context, such as a conf.d file.
# Retain your real certificate paths and ACME challenge configuration.
limit_req_zone $binary_remote_addr zone=blog_clients:10m rate=10r/s;
limit_req_zone $server_name zone=blog_total:1m rate=30r/s;
limit_req_zone $binary_remote_addr zone=blog_auth:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=blog_connections:10m;

server {
    listen 80;
    server_name xxx.com;
    access_log off;
    error_log /var/log/nginx/ghost-blog.error.log warn;
    log_not_found off;
    location ^~ /.well-known/acme-challenge/ {
        # Match the webroot used by your existing certificate renewal setup.
        root /var/www/acme;
        try_files $uri =404;
    }
    location / { return 301 https://xxx.com$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name xxx.com;
    ssl_certificate /etc/letsencrypt/live/xxx.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xxx.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    server_tokens off;
    access_log off;
    error_log /var/log/nginx/ghost-blog.error.log warn;
    log_not_found off;
    limit_req_log_level notice;
    limit_conn_log_level notice;
    limit_req_status 429;
    limit_conn_status 429;
    limit_req zone=blog_clients burst=40 nodelay;
    limit_req zone=blog_total burst=60 nodelay;
    limit_conn blog_connections 20;
    client_max_body_size 32m;
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 15s;

    # Overwrite incoming forwarding headers; do not append untrusted client input.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }
    location ~ (^|/)\. { return 404; }
    location ~* \.(php|asp|aspx|jsp)$ { return 404; }
    location = /admin { return 404; }
    location ^~ /admin/ { return 404; }
    location = /api/admin/login {
        client_max_body_size 8k;
        limit_req zone=blog_auth burst=5 nodelay;
        limit_req zone=blog_total burst=60 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location ^~ /api/auth/ {
        client_max_body_size 8k;
        limit_req zone=blog_auth burst=5 nodelay;
        limit_req zone=blog_total burst=60 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location = /api/analytics/events {
        client_max_body_size 2k;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
    }
}
